# Apache Kudu devenv Configuration Example
# Copy this file to .env and customize for your local environment

# ==============================================================================
# Installation Configuration
# ==============================================================================

# DESTDIR: Installation destination for 'make install'
# Default: unset (installs to system default, typically /usr/local)
# Uncomment and set to install to a custom location:
#DESTDIR=~/kudu-install

# ==============================================================================
# Cluster Configuration
# ==============================================================================

# CLUSTER_DIR: Directory for cluster data (WAL, data files, logs)
# Default: /tmp/kudu-<version> (created automatically)
# Recommendation: Use a persistent location (e.g., on RAID) for development work
#CLUSTER_DIR=/tmp/kudu-cluster

# NUM_MASTERS: Number of master servers to run
# Default: 1 (single master for development)
# Production typically uses 3 or 5 for high availability
NUM_MASTERS=1

# NUM_TSERVERS: Number of tablet servers to run
# Default: 3 (minimum for default replication factor)
NUM_TSERVERS=3

# ==============================================================================
# Network Configuration
# ==============================================================================

# WEB_IP: Bind address for web UI interfaces
# Default: 127.0.0.1 (localhost only, most secure)
# Set to 0.0.0.0 to allow remote access from other machines
WEB_IP=127.0.0.1

# WEB_ADVERTISED_IP: IP address advertised to clients for web UI
# Default: unset (uses WEB_IP value)
# Set this when WEB_IP is 0.0.0.0 but you want to advertise a specific IP
#WEB_ADVERTISED_IP=192.168.1.100

# RPC_IP: Bind address for RPC communication
# Default: 127.0.0.1 (localhost only, standard for development)
# Note: For multi-node clusters, this would need to be a reachable IP
RPC_IP=127.0.0.1

# ==============================================================================
# Build Configuration
# ==============================================================================

# BUILD_TYPE: CMake build type to use
# Options: debug, release, fastdebug
# Default: debug (for development with symbols and assertions)
# Note: The devenv provides separate tasks for debug and release builds
#BUILD_TYPE=debug

# ==============================================================================
# Notes
# ==============================================================================

# TLS/Authentication:
#   - TLS and authentication are automatically disabled in devenv for development
#   - This simplifies local testing and avoids OpenSSL 3.x compatibility issues
#   - For production-like testing, use --rpc_encryption=required and
#     --rpc_authentication=required flags

# Remote Access:
#   - To access the web UI from another machine:
#     1. Set WEB_IP=0.0.0.0
#     2. Set WEB_ADVERTISED_IP to your machine's IP address
#     3. Ensure firewall allows connections on ports 8765 (master) and 9871+ (tservers)

# Performance:
#   - Use RELEASE builds for performance testing (devenv tasks run kudu:build-release)
#   - DEBUG builds include extra assertions and checks that impact performance
#   - The devenv automatically uses all available CPU cores for parallel builds

# Data Persistence:
#   - If CLUSTER_DIR is not set, data goes to /tmp and may be lost on reboot
#   - Set CLUSTER_DIR to a persistent location if you need data to survive restarts
#   - Consider using SSD or NVMe storage for CLUSTER_DIR for better performance
